{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-meteo-temperature-1.schema.json",
  "title": "hydrolog-meteo-temperature/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "index",
    "year_type",
    "first_year",
    "last_year",
    "period_years",
    "years",
    "period"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-meteo-temperature/1"
    },
    "index": {
      "type": "string"
    },
    "year_type": {
      "type": "string"
    },
    "first_year": {
      "type": "integer"
    },
    "last_year": {
      "type": "integer"
    },
    "period_years": {
      "type": "integer"
    },
    "reference_first_year": {
      "type": "integer"
    },
    "reference_last_year": {
      "type": "integer"
    },
    "reference_period_years": {
      "type": "integer"
    },
    "years": {
      "type": "array"
    },
    "period": {
      "type": "object"
    },
    "frost_tmin_c": {
      "type": "number"
    },
    "ice_tmax_c": {
      "type": "number"
    },
    "summer_tmax_c": {
      "type": "number"
    },
    "hot_tmax_c": {
      "type": "number"
    },
    "tropical_tmin_c": {
      "type": "number"
    },
    "growing_base_c": {
      "type": "number"
    },
    "heating_base_c": {
      "type": "number"
    },
    "heating_limit_c": {
      "type": "number"
    }
  }
}
