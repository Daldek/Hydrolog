{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-gui-serve-1.schema.json",
  "title": "hydrolog-gui-serve/1",
  "description": "Where and when `gui serve` served once it has stopped: the address of the page and the times it started and stopped (ISO 8601, UTC; ADR-0014).",
  "type": "object",
  "required": [
    "schema",
    "url",
    "started_at",
    "stopped_at"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-gui-serve/1"
    },
    "url": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "stopped_at": {
      "type": "string"
    }
  }
}
