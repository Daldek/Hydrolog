  "required": [
    "schema",
    "n_years",
    "annual_maxima",
    "hydrological_years",
    "best_distribution",
    "distributions",
    "empirical",
    "incomplete_years"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-stats-flood-frequency/1"
    },
    "n_years": {
      "type": "integer"
    },
    "annual_maxima": {
      "type": "array"
    },
    "hydrological_years": {
      "type": [
        "null",
        "array"
      ]
    },
    "best_distribution": {
      "type": "string"
    },
    "distributions": {
      "type": "array"
    },
    "empirical": {
      "type": "object"
    },
    "incomplete_years": {
      "type": [
        "null",
        "array"
      ]
    }
  }
}
