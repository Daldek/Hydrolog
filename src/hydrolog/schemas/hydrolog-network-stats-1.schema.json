{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-network-stats-1.schema.json",
  "title": "hydrolog-network-stats/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "method",
    "n_segments",
    "stream_frequency_per_km2",
    "statistics"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-network-stats/1"
    },
    "method": {
      "type": "string"
    },
    "n_segments": {
      "type": "integer"
    },
    "stream_frequency_per_km2": {
      "type": "number"
    },
    "statistics": {
      "type": "object"
    }
  }
}
