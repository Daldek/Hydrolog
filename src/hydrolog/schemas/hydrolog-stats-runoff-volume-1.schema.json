{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-stats-runoff-volume-1.schema.json",
  "title": "hydrolog-stats-runoff-volume/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "first_year",
    "last_year",
    "period_years",
    "years",
    "n_complete_years",
    "mean_annual_volume_m3",
    "monthly_mean_volume_m3",
    "cumulative_year",
    "cumulative_volume_m3",
    "mean_cumulative_volume_m3"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-stats-runoff-volume/1"
    },
    "first_year": {
      "type": "integer"
    },
    "last_year": {
      "type": "integer"
    },
    "period_years": {
      "type": "integer"
    },
    "years": {
      "type": "array"
    },
    "n_complete_years": {
      "type": "integer"
    },
    "mean_annual_volume_m3": {
      "type": "number"
    },
    "monthly_mean_volume_m3": {
      "type": "array"
    },
    "cumulative_year": {
      "type": "integer"
    },
    "cumulative_volume_m3": {
      "type": "array"
    },
    "mean_cumulative_volume_m3": {
      "type": "array"
    }
  }
}
