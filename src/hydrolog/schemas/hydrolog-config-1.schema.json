{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-config-1.schema.json",
  "title": "hydrolog-config/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "settings",
    "config_file",
    "credentials",
    "store"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-config/1"
    },
    "settings": {
      "type": "array"
    },
    "config_file": {
      "type": "object"
    },
    "credentials": {
      "type": "array"
    },
    "store": {}
  }
}
