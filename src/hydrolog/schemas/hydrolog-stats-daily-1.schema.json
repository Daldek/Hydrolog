    },
    "day_of_year": {
      "type": "array"
    },
    "max_values": {
      "type": "array"
    },
    "mean_values": {
      "type": "array"
    },
    "median_values": {
      "type": "array"
    },
    "min_values": {
      "type": "array"
    },
    "count": {
      "type": "array"
    }
  }
}
