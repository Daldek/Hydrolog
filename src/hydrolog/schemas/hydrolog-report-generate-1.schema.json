{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-report-generate-1.schema.json",
  "title": "hydrolog-report-generate/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "output_path",
    "size_bytes",
    "sections",
    "watershed_name",
    "peak_discharge_m3s",
    "time_to_peak_min",
    "total_volume_m3",
    "total_precipitation_mm",
    "total_effective_mm",
    "runoff_coefficient",
    "cn_used"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-report-generate/1"
    },
    "output_path": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer"
    },
    "sections": {
      "type": "array"
    },
    "watershed_name": {
      "type": "string"
    },
    "peak_discharge_m3s": {
      "type": "number"
    },
    "time_to_peak_min": {
      "type": "number"
    },
    "total_volume_m3": {
      "type": "number"
    },
    "total_precipitation_mm": {
      "type": "number"
    },
    "total_effective_mm": {
      "type": "number"
    },
    "runoff_coefficient": {
      "type": "number"
    },
    "cn_used": {
      "type": "number"
    }
  }
}
