{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-meteo-spells-1.schema.json",
  "title": "hydrolog-meteo-spells/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "threshold_mm",
    "year_type",
    "first_year",
    "last_year",
    "period_years",
    "n_spells",
    "max_length_days",
    "spells",
    "years",
    "period"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-meteo-spells/1"
    },
    "kind": {
      "type": "string"
    },
    "threshold_mm": {
      "type": "number"
    },
    "year_type": {
      "type": "string"
    },
    "first_year": {
      "type": "integer"
    },
    "last_year": {
      "type": "integer"
    },
    "period_years": {
      "type": "integer"
    },
    "n_spells": {
      "type": "integer"
    },
    "max_length_days": {
      "type": "integer"
    },
    "spells": {
      "type": "array"
    },
    "years": {
      "type": "array"
    },
    "period": {
      "type": "object"
    }
  }
}
