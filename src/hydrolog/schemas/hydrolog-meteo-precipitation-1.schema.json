{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-meteo-precipitation-1.schema.json",
  "title": "hydrolog-meteo-precipitation/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "index",
    "year_type",
    "first_year",
    "last_year",
    "period_years",
    "years",
    "period"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-meteo-precipitation/1"
    },
    "index": {
      "type": "string"
    },
    "year_type": {
      "type": "string"
    },
    "first_year": {
      "type": "integer"
    },
    "last_year": {
      "type": "integer"
    },
    "period_years": {
      "type": "integer"
    },
    "years": {
      "type": "array"
    },
    "period": {
      "type": "object"
    },
    "durations_days": {
      "type": "array"
    },
    "thresholds_mm": {
      "type": "array"
    },
    "wet_day_mm": {
      "type": "number"
    },
    "percentiles": {
      "type": "array"
    }
  }
}
