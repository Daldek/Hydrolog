      "const": "hydrolog-hydrometrics-rating-curve/1"
    },
    "a": {
      "type": "number"
    },
    "b": {
      "type": "number"
    },
    "h0": {
      "type": "number"
    },
    "r_squared": {
      "type": "number"
    },
    "std_residuals": {
      "type": "number"
    },
    "n_points": {
      "type": "integer"
    },
    "n_outliers_removed": {
      "type": "integer"
    }
  }
}
