{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-scs-effective-1.schema.json",
  "title": "hydrolog-scs-effective/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "cn",
    "amc",
    "cn_adjusted",
    "ia_coefficient",
    "retention_mm",
    "initial_abstraction_mm",
    "total_precipitation_mm",
    "total_effective_mm",
    "runoff_coefficient",
    "effective_mm"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-scs-effective/1"
    },
    "cn": {
      "type": "number"
    },
    "amc": {
      "type": "string"
    },
    "cn_adjusted": {
      "type": "number"
    },
    "ia_coefficient": {
      "type": "number"
    },
    "retention_mm": {
      "type": "number"
    },
    "initial_abstraction_mm": {
      "type": "number"
    },
    "total_precipitation_mm": {
      "type": "number"
    },
    "total_effective_mm": {
      "type": "number"
    },
    "runoff_coefficient": {
      "type": "number"
    },
    "effective_mm": {
      "type": [
        "null",
        "array"
      ]
    }
  }
}
