{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-soil-texture-1.schema.json",
  "title": "hydrolog-soil-texture/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "texture_class",
    "texture_code",
    "hsg",
    "hsg_code"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-soil-texture/1"
    },
    "texture_class": {
      "type": "string"
    },
    "texture_code": {
      "type": "integer"
    },
    "hsg": {
      "type": "string"
    },
    "hsg_code": {
      "type": "integer"
    }
  }
}
