{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-stats-homogeneity-1.schema.json",
  "title": "hydrolog-stats-homogeneity/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "n_years",
    "split_index",
    "split_year",
    "mann_whitney",
    "kolmogorov_smirnov",
    "pettitt",
    "significance_level"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-stats-homogeneity/1"
    },
    "n_years": {
      "type": "integer"
    },
    "split_index": {
      "type": "integer"
    },
    "split_year": {
      "type": [
        "null",
        "integer"
      ]
    },
    "mann_whitney": {
      "type": "object"
    },
    "kolmogorov_smirnov": {
      "type": "object"
    },
    "pettitt": {
      "type": "object"
    },
    "significance_level": {
      "type": "number"
    }
  }
}
