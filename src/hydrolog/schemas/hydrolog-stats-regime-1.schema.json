{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-stats-regime-1.schema.json",
  "title": "hydrolog-stats-regime/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "first_year",
    "last_year",
    "period_years",
    "n_values",
    "months",
    "monthly_mean",
    "annual_mean",
    "parde",
    "regime_type",
    "spring_share",
    "seasonality_index"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-stats-regime/1"
    },
    "first_year": {
      "type": "integer"
    },
    "last_year": {
      "type": "integer"
    },
    "period_years": {
      "type": "integer"
    },
    "n_values": {
      "type": "integer"
    },
    "months": {
      "type": "array"
    },
    "monthly_mean": {
      "type": "array"
    },
    "annual_mean": {
      "type": "number"
    },
    "parde": {
      "type": "array"
    },
    "regime_type": {
      "type": "object"
    },
    "spring_share": {
      "type": "number"
    },
    "seasonality_index": {
      "type": "number"
    }
  }
}
