{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-meteo-spi-1.schema.json",
  "title": "hydrolog-meteo-spi/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "scales_months",
    "year_type",
    "first_year",
    "last_year",
    "period_years",
    "reference_first_year",
    "reference_last_year",
    "reference_period_years",
    "months",
    "years",
    "period"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-meteo-spi/1"
    },
    "scales_months": {
      "type": "array"
    },
    "year_type": {
      "type": "string"
    },
    "first_year": {
      "type": "integer"
    },
    "last_year": {
      "type": "integer"
    },
    "period_years": {
      "type": "integer"
    },
    "reference_first_year": {
      "type": "integer"
    },
    "reference_last_year": {
      "type": "integer"
    },
    "reference_period_years": {
      "type": "integer"
    },
    "months": {
      "type": "array"
    },
    "years": {
      "type": "array"
    },
    "period": {
      "type": "object"
    }
  }
}
