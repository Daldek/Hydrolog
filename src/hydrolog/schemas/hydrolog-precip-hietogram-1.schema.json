{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-precip-hietogram-1.schema.json",
  "title": "hydrolog-precip-hietogram/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "hietogram_type",
    "total_mm",
    "duration_min",
    "timestep_min",
    "n_steps",
    "parameters",
    "peak_intensity_mm_per_h",
    "times_min",
    "depths_mm",
    "intensities_mm_per_h"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-precip-hietogram/1"
    },
    "hietogram_type": {
      "type": "string"
    },
    "total_mm": {
      "type": "number"
    },
    "duration_min": {
      "type": "number"
    },
    "timestep_min": {
      "type": "number"
    },
    "n_steps": {
      "type": "integer"
    },
    "parameters": {
      "type": "object"
    },
    "peak_intensity_mm_per_h": {
      "type": "number"
    },
    "times_min": {
      "type": "array"
    },
    "depths_mm": {
      "type": "array"
    },
    "intensities_mm_per_h": {
      "type": "array"
    }
  }
}
