{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-stats-mann-kendall-1.schema.json",
  "title": "hydrolog-stats-mann-kendall/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "s_statistic",
    "var_s",
    "z_score",
    "p_value",
    "trend_detected",
    "trend_direction",
    "significance_level"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-stats-mann-kendall/1"
    },
    "s_statistic": {
      "type": "number"
    },
    "var_s": {
      "type": "number"
    },
    "z_score": {
      "type": "number"
    },
    "p_value": {
      "type": "number"
    },
    "trend_detected": {
      "type": "boolean"
    },
    "trend_direction": {
      "type": "string"
    },
    "significance_level": {
      "type": "number"
    }
  }
}
