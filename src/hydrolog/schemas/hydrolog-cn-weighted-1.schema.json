{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-cn-weighted-1.schema.json",
  "title": "hydrolog-cn-weighted/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "cn",
    "n_parts",
    "total_area",
    "shares"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-cn-weighted/1"
    },
    "cn": {
      "type": "number"
    },
    "n_parts": {
      "type": "integer"
    },
    "total_area": {
      "type": [
        "null",
        "number"
      ]
    },
    "shares": {
      "type": "array"
    }
  }
}
