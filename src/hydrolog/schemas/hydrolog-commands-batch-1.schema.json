{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-commands-batch-1.schema.json",
  "title": "hydrolog-commands-batch/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "n_calls",
    "n_ok",
    "n_failed",
    "failed"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-commands-batch/1"
    },
    "n_calls": {
      "type": "integer"
    },
    "n_ok": {
      "type": "integer"
    },
    "n_failed": {
      "type": "integer"
    },
    "failed": {
      "type": "array"
    }
  }
}
