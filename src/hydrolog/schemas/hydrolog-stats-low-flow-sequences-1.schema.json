{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-stats-low-flow-sequences-1.schema.json",
  "title": "hydrolog-stats-low-flow-sequences/1",
  "description": "Domain document of the result envelope hydrolog-result/1 (generated by scripts/generate_result_schemas.py). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "threshold",
    "min_duration_days",
    "max_gap_days",
    "n_days",
    "n_events",
    "total_deficit",
    "max_duration_days",
    "sequences"
  ],
  "properties": {
    "schema": {
      "const": "hydrolog-stats-low-flow-sequences/1"
    },
    "threshold": {
      "type": "number"
    },
    "min_duration_days": {
      "type": "integer"
    },
    "max_gap_days": {
      "type": "integer"
    },
    "n_days": {
      "type": "integer"
    },
    "n_events": {
      "type": "integer"
    },
    "total_deficit": {
      "type": "number"
    },
    "max_duration_days": {
      "type": "integer"
    },
    "sequences": {
      "type": "array"
    }
  }
}
