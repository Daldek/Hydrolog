# Environment variables read by Hydrolog (DEV-13.1, DEV-18.3). Hydrolog reads the process
# environment and does not load .env itself: export what you need, for example with
# `set -a; . ./.env; set +a`. Its one credential is the key of the web GUI's admin page.
# Precedence of the settings: command-line option, HYDROLOG_<KEY>, NOGAT_<KEY>, nogat.toml,
# default.

# Language of human-readable CLI output: pl or en (default pl); JSON output stays English.
HYDROLOG_LANG=

# Log level of the CLI on stderr: debug, info, warning or error (default warning).
HYDROLOG_LOG_LEVEL=

# Data directory (default: the user data directory of nogat, e.g. ~/.local/share/nogat);
# the web GUI keeps the reports of „Zgłoś uwagę” in <data_dir>/hydrolog/feedback.sqlite3.
HYDROLOG_DATA_DIR=

# Language shared by the Nogat tools; HYDROLOG_LANG wins over it.
NOGAT_LANG=

# Log level shared by the Nogat tools; HYDROLOG_LOG_LEVEL wins over it.
NOGAT_LOG_LEVEL=

# Data directory shared by the Nogat tools; HYDROLOG_DATA_DIR wins over it.
NOGAT_DATA_DIR=

# Path of the settings file nogat.toml (default: nogat.toml in the user config directory).
NOGAT_CONFIG=

# Credential (never in nogat.toml): the key of the web GUI's admin page (admin/), sent in
# X-Admin-Key; without it, or a file that holds it, the admin page refuses everything.
HYDROLOG_ADMIN_API_KEY=

# Path of a file that holds that key (a secret file of a service), read when
# HYDROLOG_ADMIN_API_KEY is not set.
HYDROLOG_ADMIN_API_KEY_FILE=
